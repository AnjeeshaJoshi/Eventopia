rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Event posters may be viewed by everyone, while only signed-in users
    // may upload them. Keeping the size and content-type limits protects the
    // bucket from arbitrary files.
    match /events/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    match /profiles/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
